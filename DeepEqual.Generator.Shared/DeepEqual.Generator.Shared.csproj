<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<PackageId>DeepEqual.Generator</PackageId>
		<Version>2.3.0</Version>
		<Authors>Mirko Sangrigoli</Authors>
		<Company>FORGE-Z Software</Company>
		<Description>Source-generated deep equality, mismatch paths, structural diffs, and binary-serializable deltas for .NET models.</Description>
		<PackageTags>deep-equality;source-generator;dotnet;diff</PackageTags>
		<PackageReleaseNotes>Save side-by-side HTML comparison reports with path and change filters. Assertion failures carry the same redaction into their HTML reports. See the GitHub Actions example for uploading reports from failing tests.</PackageReleaseNotes>
		<RepositoryUrl>https://github.com/forge-z-software/DeepEqualGenerator</RepositoryUrl>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>Readme.md</PackageReadmeFile>
		<PackageIcon>icon.png</PackageIcon>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<Nullable>enable</Nullable>
		<DefineConstants>$(DefineConstants);ACCESS_TRACK;ACCESS_TRACK_COUNTS;ACCESS_TRACK_LAST;ACCESS_TRACK_LOG</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
		<ProjectReference Include="..\DeepEqual.Generator\DeepEqual.Generator.csproj"
			ReferenceOutputAssembly="false" PrivateAssets="all" />
		<ProjectReference Include="..\DeepEqual.Generator.CodeFixes\DeepEqual.Generator.CodeFixes.csproj"
			ReferenceOutputAssembly="false" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\Readme.md" Pack="true" PackagePath="\" />
		<None Include="..\docs\*.md" Pack="true" PackagePath="docs" />
		<None Include="..\LICENSE" Pack="true" PackagePath="\" />
		<None Include="..\icon.png" Pack="true" PackagePath="\" />
		<None Include="..\DeepEqual.Generator\bin\$(Configuration)\netstandard2.0\DeepEqual.Generator.dll"
			Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
		<None Include="..\DeepEqual.Generator.CodeFixes\bin\$(Configuration)\netstandard2.0\DeepEqual.Generator.CodeFixes.dll"
			Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
	</ItemGroup>
</Project>
